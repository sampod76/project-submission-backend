enum Role {
  ADMIN
  MENTOR
  STUDENT

  @@schema("auth")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique() @db.VarChar(255)
  password String @db.VarChar(255)

  role              Role               @default(STUDENT)
  isActive          Boolean            @default(true) @map("is_active")
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(0)
  isDeleted         Boolean            @default(false) @map("is_deleted")
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(0)
  admin             Admin?
  mentor            Mentor?
  student           Student?
  submissionReviews SubmissionReview[]
  auditLogs         AuditLog[]

  @@map("users")
  @@schema("auth")
}
