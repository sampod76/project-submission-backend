# production
NODE_ENV=development
PORT=5000

# 
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_submission?schema=public
# Separate database for pnpm test:integration; never reuse DATABASE_URL's database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_submission_test?schema=public
JWT_SECRET=replace-with-32-char-random-string
# 7 day
JWT_EXPIRES_IN=604800

JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
# 30 day
JWT_REFRESH_EXPIRES_IN=2592000

BCRYPT_SALT_ROUNDS=12

# 
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Logger
LOG_LEVEL=info


# Initial administrator (set credentials before pnpm seed)
SEED_ADMIN_EMAIL=admin@project-submission.local
SEED_ADMIN_PASSWORD=Ad11223344?
SEED_ADMIN_FIRST_NAME=Project
SEED_ADMIN_LAST_NAME=Administrator

# Initial mentor (set credentials before pnpm seed)
SEED_MENTOR_EMAIL=mentor@example.com
SEED_MENTOR_PASSWORD=Me11223344?
SEED_MENTOR_FIRST_NAME=Default
SEED_MENTOR_LAST_NAME=Mentor

# Endpoint-specific rate limits
REGISTRATION_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=20
SUBMISSION_RATE_LIMIT_MAX=20
