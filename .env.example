# production
NODE_ENV=development
PORT=5000

# 
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_tracker?schema=public
# Separate database for pnpm test:integration; never reuse DATABASE_URL's database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_tracker_test?schema=public
JWT_SECRET=replace-with-32-char-random-string
# 7 day
JWT_EXPIRES_IN=604800

JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
# 30 day
JWT_REFRESH_EXPIRES_IN=2592000

BCRYPT_SALT_ROUNDS=12

# 
CORS_ORIGIN=https://doctor-tracker-ai.iblossomlearn.org,https://doctor-tracker-ai-pro.netlify.app,http://localhost:3000,http://192.168.0.100:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Logger
LOG_LEVEL=info

